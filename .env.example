# Secret: server-side Honcho access token. Never paste this into ChatGPT.
HONCHO_API_KEY=

# Secret: server-side Honcho refresh token for renewing expired access tokens.
HONCHO_REFRESH_TOKEN=
HONCHO_OAUTH_CLIENT_ID=hermes-agent
HONCHO_OAUTH_TOKEN_ENDPOINT=https://api.honcho.dev/oauth/token

# Secret: bearer token Custom GPT uses to call this bridge.
BRIDGE_API_KEY=

# Non-secret identity mapping.
HONCHO_WORKSPACE=hermes
HONCHO_USER_PEER=Norm
HONCHO_AI_PEER=ChatGPT
HONCHO_SESSION=chatgpt

# Set this after deployment, e.g. https://honcho-chatgpt-bridge.onrender.com
PUBLIC_BASE_URL=
